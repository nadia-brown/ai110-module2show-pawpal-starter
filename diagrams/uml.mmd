classDiagram
    %% PawPal+ — pet care planning assistant
    %% An Owner has Pets; each Pet has care Tasks. The Scheduler builds a
    %% DailyPlan from those tasks using time constraints, priority, and preferences.

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class TaskCategory {
        <<enumeration>>
        WALK
        FEEDING
        MEDS
        GROOMING
        ENRICHMENT
        OTHER
    }

    class Frequency {
        <<enumeration>>
        DAILY
        WEEKLY
    }

    class Owner {
        +str name
        +int available_minutes
        +time day_start
        +time day_end
        +list~Pet~ pets
        +list~Preference~ preferences
        +add_pet(pet: Pet) None
        +remove_pet(pet_name: str) None
        +get_pet(pet_name: str) Pet
        +add_preference(pref: Preference) None
        +get_all_tasks() list~tuple~Pet, Task~~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task_title: str) None
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +TimeConstraint time_constraint
        +TaskCategory category
        +Frequency frequency
        +int weekday
        +bool shareable
        +set~date~ completed_dates
        +mark_complete(on: date) None
        +is_complete_on(day: date) bool
        +is_due_on(day: date) bool
        +has_time_constraint() bool
        +is_fixed() bool
        +priority_score() int
    }

    class TimeConstraint {
        +time earliest_start
        +time latest_end
        +bool is_fixed
        +fits(start: time, duration_minutes: int) bool
    }

    class Preference {
        +str description
        +str preferred_time_of_day
        +int weight
        +list~TaskCategory~ categories
        +str pet_name
        +applies_to(task: Task, pet: Pet) bool
        +window() tuple~int, int~
    }

    class Scheduler {
        +Owner owner
        +date plan_date
        +generate_plan() DailyPlan
        +score_task(task: Task, pet: Pet) int
        +sort_tasks(tasks: list~tuple~Pet, Task~~) list~tuple~Pet, Task~~
        +filter_tasks(tasks: list~tuple~Pet, Task~~) list~tuple~Pet, Task~~
        +find_slot(task: Task, pet: Pet, plan: DailyPlan) time
        +detect_conflicts(plan: DailyPlan) list~str~
    }

    class DailyPlan {
        +date plan_date
        +list~ScheduledTask~ items
        +list~tuple~Task, Pet, str~~ skipped_tasks
        +add_item(item: ScheduledTask) None
        +total_minutes() int
        +view_tasks() list~ScheduledTask~
        +explain() str
    }

    class ScheduledTask {
        +Task task
        +Pet pet
        +time start_time
        +time end_time
        +str reason
        +overlaps(other: ScheduledTask) bool
        +can_share_time_with(task: Task, pet: Pet) bool
    }

    Owner "1" *-- "0..*" Pet : owns
    Owner "1" o-- "0..*" Preference : has
    Pet "1" *-- "0..*" Task : needs
    Task --> Priority : uses
    Task --> TaskCategory : is a
    Task --> Frequency : repeats
    Task "1" o-- "0..1" TimeConstraint : limited by
    Preference --> TaskCategory : matches
    Preference ..> Pet : optionally for
    Scheduler --> Owner : reads pets & preferences
    Scheduler ..> DailyPlan : creates
    Scheduler ..> Preference : applies
    DailyPlan "1" *-- "0..*" ScheduledTask : contains
    ScheduledTask --> Task : schedules
    ScheduledTask --> Pet : for
